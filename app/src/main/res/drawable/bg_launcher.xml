<?xml version="1.0" encoding="utf-8"?>
<!-- 首页背景：晴空渐变 + 两朵淡淡的白云（卡片之间能看到） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient
                android:angle="270"
                android:endColor="@color/sky_bottom"
                android:startColor="@color/sky_top" />
        </shape>
    </item>
    <item
        android:width="220dp"
        android:height="110dp"
        android:drawable="@drawable/ic_cloud"
        android:end="-40dp"
        android:gravity="top|end"
        android:top="74dp" />
    <item
        android:width="260dp"
        android:height="130dp"
        android:bottom="-30dp"
        android:drawable="@drawable/ic_cloud"
        android:gravity="bottom|start"
        android:start="-60dp" />
</layer-list>
