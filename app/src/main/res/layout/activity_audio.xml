<?xml version="1.0" encoding="utf-8"?>
<!-- 竖屏：上面播放控制，下面播放列表（和横屏版 layout-land/activity_audio.xml 的控件 id 保持一致） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_audio">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/bg_round_dark"
                android:contentDescription="返回"
                android:padding="12dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back_white" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 播放列表收起时显示，点了展开 -->
            <TextView
                android:id="@+id/btnShowPlaylist"
                style="@style/PillButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:text="☰ 播放列表（118）"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="🎧"
            android:textSize="72sp" />

        <!-- 目录完整标题 -->
        <TextView
            android:id="@+id/txtDir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:textColor="#B3FFFFFF"
            android:textSize="16sp"
            android:visibility="gone"
            tools:text="RAZ全套音频Aa-Z2 / Level C"
            tools:visibility="visible" />

        <!-- 文件名：不截断，太长就换行显示完整 -->
        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="Book 9 Level C Big Lizard, little Lizard" />

        <TextView
            android:id="@+id/txtError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textColor="#FFFF9A9A"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.media3.ui.PlayerControlView
            android:id="@+id/controlView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:show_shuffle_button="true"
            app:show_timeout="0"
            app:repeat_toggle_modes="one|all" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtScreenOff"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#B3FFFFFF"
                android:textSize="15sp"
                tools:text="12 秒后自动息屏，闭上眼睛听吧" />

            <Button
                android:id="@+id/btnScreenOff"
                style="@style/KidButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_moon"
                android:drawablePadding="8dp"
                android:text="现在息屏"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 播放列表（可以收起） -->
        <LinearLayout
            android:id="@+id/playlistPanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:background="@drawable/bg_playlist"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/txtPlaylistHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="#B3FFFFFF"
                    android:textSize="15sp"
                    tools:text="播放列表 12 首 · 按住 ≡ 拖动排序 · 点 ✕ 删除" />

                <TextView
                    android:id="@+id/btnHidePlaylist"
                    style="@style/PillButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="收起" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/playlist"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:layout_weight="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- 没有设备管理器权限时的“假息屏”：全黑 + 最低亮度，点一下恢复 -->
    <View
        android:id="@+id/blackout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />
</FrameLayout>
